+const fill = require('fill-range');
+const stringify = require('./stringify');
+const utils = require('./utils');
+
+const append = (queue = '', stash = '', enclose = false) => {
+  let output;
+  const tasks = [{ queue, stash, target: value => { output = value; } }];
+  while (tasks.length) {
+    const task = tasks.pop();
+    if (task.finish) {
+      task.target(utils.flatten(task.result));
+      continue;
+    }
+    const q = [].concat(task.queue === undefined ? '' : task.queue);
+    const s = [].concat(task.stash === undefined ? '' : task.stash);
+    if (!s.length) {
+      task.target(q);
+      continue;
+    }
+    if (!q.length) {
+      task.target(enclose ? utils.flatten(s).map(ele => `{${ele}}`) : s);
+      continue;
+    }
+    const result = [];
+    const children = [];
+    for (const item of q) {
+      if (Array.isArray(item)) {
+        for (const value of item) {
+          const index = result.length;
+          result.push(undefined);
+          children.push({ queue: value, stash: s, target: value => { result[index] = value; } });
+        }
+      } else {
+        for (let ele of s) {
+          if (enclose === true && typeof ele === 'string') ele = `{${ele}}`;
+          if (Array.isArray(ele)) {
+            const index = result.length;
+            result.push(undefined);
+            children.push({ queue: item, stash: ele, target: value => { result[index] = value; } });
+          } else {
+            result.push(item + ele);
+          }
+        }
+      }
+    }
+    tasks.push({ finish: true, result, target: task.target });
+    for (let i = children.length - 1; i >= 0; i--) tasks.push(children[i]);
+  }
+  return output;
+};
+
+const expand = (ast, options = {}) => {
+  const rangeLimit = options.rangeLimit === undefined ? 1000 : options.rangeLimit;
+
+  const enter = (node, parent = {}) => {
+    node.queue = [];
+
+    let p = parent;
+    let q = parent.queue;
+
+    while (p.type !== 'brace' && p.type !== 'root' && p.parent) {
+      p = p.parent;
+      q = p.queue;
+    }
+
+    if (node.invalid || node.dollar) {
+      q.push(append(q.pop(), stringify(node, options)));
+      return;
+    }
+
+    if (node.type === 'brace' && node.invalid !== true && node.nodes.length === 2) {
+      q.push(append(q.pop(), ['{}']));
+      return;
+    }
+
+    if (node.nodes && node.ranges > 0) {
+      const args = utils.reduce(node.nodes);
+
+      if (utils.exceedsLimit(...args, options.step, rangeLimit)) {
+        throw new RangeError('expanded array length exceeds range limit. Use options.rangeLimit to increase or disable the limit.');
+      }
+
+      let range = fill(...args, options);
+      if (range.length === 0) {
+        range = stringify(node, options);
+      }
+
+      q.push(append(q.pop(), range));
+      node.nodes = [];
+      return;
+    }
+
+    const enclose = utils.encloseBrace(node);
+    let queue = node.queue;
+    let block = node;
+
+    while (block.type !== 'brace' && block.type !== 'root' && block.parent) {
+      block = block.parent;
+      queue = block.queue;
+    }
+
+    return { node, q, queue, enclose, index: 0 };
+  };
+
+  const root = enter(ast);
+  const stack = root ? [root] : [];
+  while (stack.length) {
+    const frame = stack[stack.length - 1];
+    const { node, q, queue, enclose } = frame;
+    if (frame.index >= node.nodes.length) {
+      stack.pop();
+      continue;
+    }
+    const i = frame.index++;
+    const child = node.nodes[i];
+    if (child.type === 'comma' && node.type === 'brace') {
+      if (i === 1) queue.push('');
+      queue.push('');
+    } else if (child.type === 'close') {
+      q.push(append(q.pop(), queue, enclose));
+    } else if (child.value && child.type !== 'open') {
+      queue.push(append(queue.pop(), child.value));
+    } else if (child.nodes) {
+      const next = enter(child, node);
+      if (next) stack.push(next);
+    }
+  }
+  return utils.flatten(root ? root.queue : undefined);
+};
+
+module.exports = expand;
